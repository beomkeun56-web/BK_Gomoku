/*
 * Cornix LP keymap, modelled on the Sofle RGB layout.
 *
 * Key positions (50):
 *   0- 5 |  6-11   top row
 *  12-17 | 18-23   home row
 *  24-29 | 32-37   bottom row      30 = left knob press, 31 = right knob press
 *  38-43 | 44-49   thumbs: 38-40 outer left, 41-43 thumb left, 44-46 thumb right, 47-49 outer right
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3
#define SYSTEM 4

// Hyper = Shift + Alt + Ctrl + Cmd, same definition as the Sofle keymap
#define HYPER LS(LA(LC(RIGHT_GUI)))
#define HYP(key) LS(LA(LC(LG(key))))

/ {
    behaviors {
        // Same hold-tap as the Sofle: tap-preferred, 300 ms.
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&kp>, <&kp>;
        };
    };

    // Lower + Raise together = System (Bluetooth, output, bootloader).
    conditional_layers {
        compatible = "zmk,conditional-layers";

        system_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <SYSTEM>;
        };
    };

    combos {
        compatible = "zmk,combos";

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <17 18>;   // G + H
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <5 6>;     // T + Y
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // | ESC/`  |  Q  |  W  |  E  |  R  |  T  |                   |  Y  |  U  |  I  |  O  |  P  | BKSPC |
            // | TAB/🌐 |  A  |  S  |  D  |  F  |  G  |                   |  H  |  J  |  K  |  L  |  ;  |  '    |   home row: GUI ALT SHIFT CTRL / CTRL SHIFT ALT GUI, HYPER on '
            // | SHIFT  |  Z  |  X  |  C  |  V  |  B  |  MUTE  |  | MB3   |  N  |  M  |  ,  |  .  |  /  | SHIFT |
            // | GUI    | ALT | CTRL| LOWER | ADJUST | ENTER |  | SPACE | ADJUST | RAISE | CTRL | ALT | GUI |

            bindings = <
&mt GRAVE ESC  &kp Q           &kp W           &kp E             &kp R        &kp T                                   &kp Y      &kp U        &kp I              &kp O            &kp P               &kp BSPC
&mt GLOBE TAB  &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F  &kp G                                   &kp H      &mt RCTRL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMI  &mt HYPER APOS
&kp LSHFT      &kp Z           &kp X           &kp C             &kp V        &kp B       &kp C_MUTE    &mkp MB3      &kp N      &kp M        &kp COMMA          &kp DOT          &kp FSLH            &kp RSHFT
&kp LGUI       &kp LALT        &kp LCTRL       &mo LOWER         &mo ADJUST   &kp RET                                 &kp SPACE  &mo ADJUST   &mo RAISE          &kp RCTRL        &kp RALT            &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            display-name = "Lower";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   | HYP A | HYP O | HYP D | HYP S |  5  |                   |  [  |  7  |  8  |  9  |  (  |  F12 |
            // |       |   !   |   @   |   #   |   $   |  %  |                   |  ^  |  4  |  5  |  6  |  )  |  |   |
            // |       |   =   |   -   |   +   |   {   |  }  |        |  |       |  ]  |  1  |  2  |  3  |  \  |      |
            // |       |       |       |       |       |     |        |  |       |     |     |     |     |  0  |      |

            bindings = <
&kp GRAVE  &kp HYP(A)  &kp HYP(O)  &kp HYP(D)  &kp HYP(S)  &kp N5                             &kp LBKT   &kp N7  &kp N8  &kp N9  &kp LPAR  &kp F12
&trans     &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT                          &kp CARET  &kp N4  &kp N5  &kp N6  &kp RPAR  &kp PIPE
&trans     &kp EQUAL   &kp MINUS   &kp PLUS    &kp LBRC    &kp RBRC   &trans       &trans     &kp RBKT   &kp N1  &kp N2  &kp N3  &kp BSLH  &trans
&trans     &trans      &trans      &trans      &trans      &trans                             &trans     &trans  &trans  &trans  &kp N0    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "Raise";

            // ------------------------------------------------------------------------------------------------------------
            // |       | INS  | PSCR | MENU  |       |      |                | PGUP |      |   ^   |      |   0   |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            // |       |      |      |       |       |      |      |  |      |      |      |       |      |       |       |

            bindings = <
&trans  &kp INS     &kp PSCRN  &kp K_CMENU  &trans       &trans                          &kp PG_UP  &trans    &kp UP    &trans     &kp N0   &trans
&trans  &kp LALT    &kp LCTRL  &kp LSHFT    &trans       &kp CLCK                        &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans  &kp K_UNDO  &kp K_CUT  &kp K_COPY   &kp K_PASTE  &trans    &trans      &trans    &trans     &trans    &trans    &trans     &trans   &trans
&trans  &trans      &trans     &trans       &trans       &trans                          &trans     &trans    &trans    &trans     &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            display-name = "Adjust";

            // Numbers on the Q-P row (Shift gives !@#$%^&*()), F-keys below, modifiers where they live on Base.
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3  |  4  |  5  |                   |  6  |  7  |  8  |  9  |  0  |  DEL  |
            // |       |  A  |  S  |  D  |  F  |     |                   |     |  J  |  K  |  L  |  ;  |  '    |   same home row mods as Base
            // | SHIFT | F1  | F2  | F3  | F4  | F5  |        |  |       | F7  | F8  | F9  | F10 | F11 | SHIFT |
            // | GUI   | ALT | CTRL|     |     |     |        |  |       |     |     |     | CTRL| ALT | GUI   |

            bindings = <
&kp ESC    &kp N1          &kp N2          &kp N3            &kp N4       &kp N5                            &kp N6   &kp N7       &kp N8             &kp N9           &kp N0              &kp DEL
&none      &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F  &none                             &none    &mt RCTRL J  &mt RIGHT_SHIFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMI  &mt HYPER APOS
&kp LSHFT  &kp F1          &kp F2          &kp F3            &kp F4       &kp F5   &trans       &trans      &kp F7   &kp F8       &kp F9             &kp F10          &kp F11             &kp RSHFT
&kp LGUI   &kp LALT        &kp LCTRL       &none             &none        &none                             &none    &none        &none              &kp RCTRL        &kp RALT            &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        system_layer {
            display-name = "System";

            // Hold Lower + Raise. Bluetooth profiles, USB/BLE output, bootloader.
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 | BT3 | BT4 | BT5 |                    | OUT USB | OUT BLE | OUT TOG |     |     |        |
            // |       |     |     |     |     |     |                    |         |         |         |     |     |        |
            // |       |     |     |     |     |     |  BOOT  |  |  BOOT  |         |         |         |     |     |        |
            // |       |     |     |     |     |     |        |  |        |         |         |         |     |     |        |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &none  &none  &none
&none       &none         &none         &none         &none         &none                                       &none         &none         &none         &none  &none  &none
&none       &none         &none         &none         &none         &none         &bootloader    &bootloader    &none         &none         &none         &none  &none  &none
&none       &none         &none         &trans        &none         &none                                       &none         &none         &trans        &none  &none  &none
            >;
        };
    };
};
