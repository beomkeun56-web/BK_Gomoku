/*
 * Cornix LP keymap for 범근님 (2026-10-12 v7 개정, 원본 2026-09-29)
 * 원천: Vial 현재 설정 사진 3장(Layer 0·1·2, Macros M0) + 261012 범근님 지시(숫자층 윗줄만, 기호층 오른손 전용, 잠금층=옛 Vial 1층).
 *
 * Key positions (50):
 *   0- 5 |  6-11   top row
 *  12-17 | 18-23   home row
 *  24-29 | 32-37   bottom row      30 = left inner(knob press), 31 = right inner(knob press)
 *  38-40 | 47-49   outer bottom keys (왼쪽 LCtrl LGui LAlt / 오른쪽 Left Down Right)
 *  41-43 | 44-46   thumbs (왼쪽 Enter · 숫자 · M0 / 오른쪽 기호 · Space · RAlt)
 *
 * 층 구조(5개): BASE 0, NUM 1, EXCEL 2, SYM 3, LOCK 4
 *   NUM  (1) 숫자층: 왼쪽 엄지 톡. 윗줄 숫자(1~0)·Esc·Bksp 만 살리고(Shift 로 !@#$%^&*()) 나머지는 전부 투명.
 *            숫자·Bksp·Del·점·쉼표를 치는 동안 유지, 다른 키(홈줄·한글 자모 등)를 치면 자동으로 기본층 복귀.
 *   SYM  (3) 기호층: 오른쪽 엄지 톡. 오른손에만 기호가 있고 왼손·엄지·바깥 아래는 전부 투명.
 *            기호·Bksp·Del·화살표를 치는 동안 유지, 왼손 키·Space·Enter 등에서 자동 복귀.
 *            두벌식 자음이 왼손이라 한글 첫 글자를 치면 꺼진다(261012 범근님 지시).
 *   LOCK (4) 잠금층: 옛 Vial 1층 그대로(숫자+기호+엑셀 단축키 Ctrl++ Alt+1 Ctrl+D Ctrl+1 포함, 글자 없음).
 *            기본층 Ctrl+A 자리(위치 25)의 &tog LOCK 으로 켜고, 숫자층 위치 24 로도 켠다. 잠금층 안 위치 13·24·42·44 로 끈다.
 *   EXCEL(2) 엑셀층: 변경 없음. 왼쪽 노브 누름(위치 30) &tt 2 (누르는 동안 엑셀층, 톡 치면 켜둔 채 유지).
 *   오른쪽 노브 누름(위치 31) = 블루투스 3번(&bt BT_SEL 2).
 *
 * 들어가기·나오기:
 *   기본층 위치 42(왼쪽 엄지 가운데)  &num_word NUM -> 숫자층, 다른 키에서 자동 복귀
 *   기본층 위치 44(오른쪽 엄지 첫 키) &sym_word SYM -> 기호층, 왼손·Space·Enter 등에서 자동 복귀
 *   기본층 위치 25(옛 Ctrl+A 자리)    &tog LOCK -> 잠금층 켜기, 숫자층 위치 24 도 같음
 *   잠금층 위치 13·24·42·44           &tog LOCK -> 잠금층 끄기
 *
 * Vial 대응 (원래 문서):
 *   TG(2)   -> &tog 2       : 엑셀층 끄기(2층 안의 키)
 *   왼쪽 안쪽 키 "+" -> &tt 2 : 누르고 있으면 엑셀층, 톡 치면 켜둔 채 유지(260928 확정 "안쪽 TG(2)->TT(2)")
 *   M0      -> &m0          : Ctrl+V 뒤 Enter
 *   "LCtl A" 같은 두 줄 키 -> &kp LC(A) (조합키)
 *   빈 키   -> &none
 *   2층 왼손 윗줄(원래 빈 키) -> 블루투스 프로필 1·2·3 / 페어링 지우기 (중앙인 왼쪽 반쪽에 있어야 양쪽 연결이 끊겨도 동작, 260929 범근님 '블루투스 연결 안 됨') / 오른손 윗줄 첫 키 USB·BT 전환 / 양쪽 반쪽에 굽기 모드 키 하나씩(&bootloader 는 누른 쪽 반쪽이 부트로더로 감: 왼쪽 윗줄 끝 = 왼쪽 반쪽, 오른쪽 윗줄 끝 = 오른쪽 반쪽). 리셋 버튼 없이 uf2 드라이브 진입. 범근님 '리셋 버튼 없는데' 260929)
 */
#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define NUM   1
#define EXCEL 2
#define SYM   3
#define LOCK  4

&num_word {
    // 261012 범근님 지시: 숫자층은 윗줄 숫자만. 숫자·Bksp·Del·점·쉼표만 유지하고, 2열(홈줄)이나 한글 자모 등 그 밖의 키는 즉시 기본층 복귀.
    //   기호·화살표는 유지 목록에서 제거(기호는 Layer 3 sym_word 로 분리). 모듈 기본값의 ignore-numbers 는 그대로 두고 ignore-modifiers 유지.
    continue-list = <N0 N1 N2 N3 N4 N5 N6 N7 N8 N9 DOT COMMA BSPC DEL KP_DOT>;
    ignore-modifiers;
};

/ {
    behaviors {
        tt: tap_toggle_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };

        // 261012 v7: 기호층(SYM) 자동 복귀. num_word 와 같은 모듈(urob/zmk-auto-layer)의 zmk,behavior-auto-layer 두 번째 인스턴스.
        //   오른손 기호·Bksp·Del·화살표만 유지. 왼손 키·Space·Enter·글자는 목록에 없어 즉시 기본층 복귀.
        sym_word: sym_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <LPAR RPAR LBKT RBKT BSLH LBRC RBRC PIPE MINUS EQUAL SEMI SQT FSLH UNDER PLUS COLON DQT QMARK GRAVE COMMA KP_ASTERISK STAR DOT TILDE LT GT EXCL KP_PLUS BSPC DEL UP DOWN LEFT RIGHT>;
            ignore-modifiers;
        };
    };

    macros {
        m0: m0_paste_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LC(V) &kp RET>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            // | Tab   | Q      | W    | E     | R   | T  |              | Y   | U     | I    | O    | P    | Bksp  |
            // | LShft | A      | S    | D     | F   | G  |              | H   | J     | K    | L    | /    | Enter |
            // | Del   | LOCK   | Z    | X     | C   | V  | TT2 | BT3    | B   | N     | M    | .    | Up   | RShft |
            // | LCtrl | LGui   | LAlt | Enter | NUM | M0 |              | SYM | Space | RAlt | Left | Down | Right |
            // (NUM = 왼쪽 엄지 num_word 숫자층 톡, SYM = 오른쪽 엄지 sym_word 기호층 톡)
            bindings = <
&kp TAB       &kp Q         &kp W         &kp E         &kp R         &kp T         &kp Y         &kp U         &kp I         &kp O         &kp P         &kp BSPC
&kp LSHFT     &kp A         &kp S         &kp D         &kp F         &kp G         &kp H         &kp J         &kp K         &kp L         &kp FSLH      &kp RET
&kp DEL       &tog LOCK     &kp Z         &kp X         &kp C         &kp V         &tt EXCEL EXCEL &bt BT_SEL 2  &kp B         &kp N         &kp M         &kp DOT       &kp UP        &kp RSHFT
&kp LCTRL     &kp LGUI      &kp LALT      &kp RET       &num_word NUM &m0           &sym_word SYM &kp SPACE     &kp RALT      &kp LEFT      &kp DOWN      &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "Num";
            // | Esc | 1 | 2 | 3 | 4 | 5 |           | 6 | 7 | 8 | 9 | 0 | Bksp |  (Shift 와 함께 치면 !@#$%^&*())
            // | 홈줄 12-23 전부 투명(홈줄을 치면 자동 복귀) |
            // | 위치 24 투명(v7: 잠금 켜기는 기본층 Ctrl+A 자리로 이동) | 나머지 전부 투명 |
            // | 아래줄 전부 투명 |
            bindings = <
&kp ESC       &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp BSPC
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        excel_layer {
            display-name = "Excel";
            // | Esc   | BT1    | BT2   | BT3 | BT지우기 | 왼쪽굽기 |       | USB/BT | -- | -- | -- | -- | 오른쪽굽기 |
            // | LShft | Ctrl+R | 1     | 2  | 3     | --     |           | --  | --  | --  | --      | --     | --    |
            // | TG2   | Up     | 4     | 5  | 6     | Ctrl+A | -- | --   | --  | --  | --  | --      | Up     | --    |
            // | Left  | Down   | Enter | -- | Space | --     |           | --  | --  | --  | Left    | Down   | Right |
            bindings = <
&kp ESC     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &bootloader          &out OUT_TOG  &none         &none         &none       &none         &bootloader
&kp LSHFT   &kp LC(R)  &kp N1   &kp N2  &kp N3     &none                                &none         &none         &none         &none       &none         &none
&tog EXCEL  &kp UP     &kp N4   &kp N5  &kp N6     &kp LC(A)  &none        &none        &none         &none         &none         &none       &kp UP        &none
&kp LEFT    &kp DOWN   &kp RET  &none   &kp SPACE  &none                                &none         &none         &none         &kp LEFT    &kp DOWN      &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            display-name = "Sym";
            // 오른손에만 기호. 왼손 0-5·12-17·24-30 과 엄지·바깥 아래 38-49 는 전부 투명(칠 때 자동 복귀)
            // |  --  |  --  |  --  |  --  |  --  |  --  |           | (  | )  | [  | ]  | \  | Bksp |
            // |  --  |  --  |  --  |  --  |  --  |  --  |           | -  | =  | ;  | '  | /  | Enter |
            // |  --  |  --  |  --  |  --  |  --  |  --  | -- | KP+ | `  | ,  | KP* | .  | Up | !  |
            // | 아래줄 38-49 전부 투명 |
            bindings = <
&trans        &trans        &trans        &trans        &trans        &trans        &kp LPAR      &kp RPAR      &kp LBKT      &kp RBKT      &kp BSLH      &kp BSPC
&trans        &trans        &trans        &trans        &trans        &trans        &kp MINUS     &kp EQUAL     &kp SEMI      &kp SQT       &kp FSLH      &kp RET
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &kp KP_PLUS   &kp GRAVE     &kp COMMA     &kp KP_ASTERISK &kp DOT       &kp UP        &kp EXCL
&trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans        &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lock_layer {
            display-name = "Lock";
            // 옛 Vial 1층 그대로(13·24·42·44 만 잠금 끄기)
            // | Esc   | 1  | 2    | 3  | 4    | 5  |           | 6   | 7  | 8  | 9  | 0  | Bksp |
            // | LShft | LOCK(끄기) | KP* | KP+ | #  | $  |      | -   | =  | [  | ]  | KP/ | Enter |
            // | LOCK(끄기) | Up | Ctrl++ | Alt+1 | Ctrl+D | Ctrl+1 | -- | -- | `  | ,  | :  | '  | Up | Del |
            // | LCtrl | Down | -- | Enter | LOCK(끄기) | M0 |    | LOCK(끄기) | Space | .  | Left | Down | Right |
            bindings = <
&kp ESC       &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp BSPC
&kp LSHFT     &tog LOCK     &kp KP_ASTERISK &kp KP_PLUS   &kp HASH      &kp DLLR      &kp MINUS     &kp EQUAL     &kp LBKT      &kp RBKT      &kp KP_SLASH  &kp RET
&tog LOCK     &kp UP        &kp LC(KP_PLUS) &kp LA(N1)    &kp LC(D)     &kp LC(N1)    &none         &none         &kp GRAVE     &kp COMMA     &kp COLON     &kp SQT       &kp UP        &kp DEL
&kp LCTRL     &kp DOWN      &none         &kp RET       &tog LOCK     &m0           &tog LOCK     &kp SPACE     &kp DOT       &kp LEFT      &kp DOWN      &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
