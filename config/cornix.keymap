/*
 * Cornix LP keymap for 범근님 (2026-09-29)
 * 원천: Vial 현재 설정 사진 3장(Layer 0·1·2, Macros M0) + 260928 확정 결정(Layer 3 없음, 자동 복귀).
 *
 * Key positions (50):
 *   0- 5 |  6-11   top row
 *  12-17 | 18-23   home row
 *  24-29 | 32-37   bottom row      30 = left inner(knob press), 31 = right inner(knob press)
 *  38-40 | 47-49   outer bottom keys (왼쪽 LCtrl LGui LAlt / 오른쪽 Left Down Right)
 *  41-43 | 44-46   thumbs (왼쪽 Enter · 숫자층 · M0 / 오른쪽 숫자층토글 · Space · RAlt)
 *
 * Vial 대응:
 *   OSL(1)  -> &num_word 1  : 숫자·기호층. 숫자/기호를 치는 동안 유지, Space·Enter·화살표·한글 등 다른 키에서 자동 복귀
 *   TG(1)   -> &tog 1       : 숫자층 켜기/끄기 토글(길게 입력할 때)
 *   TG(2)   -> &tog 2       : 엑셀층 끄기(2층 안의 키)
 *   왼쪽 안쪽 키 "+" -> &tt 2 : 누르고 있으면 엑셀층, 톡 치면 켜둔 채 유지(260928 확정 "안쪽 TG(2)→TT(2)")
 *   M0      -> &m0          : Ctrl+V 뒤 Enter
 *   "LCtl A" 같은 두 줄 키 -> &kp LC(A) (조합키)
 *   빈 키   -> &none
 *   2층 왼손 윗줄(원래 빈 키) -> 블루투스 프로필 1·2·3 / 페어링 지우기 (중앙인 왼쪽 반쪽에 있어야 양쪽 연결이 끊겨도 동작, 260929 범근님 '블루투스 연결 안 됨') / 오른손 윗줄 첫 키 USB·BT 전환 / 양쪽 반쪽에 굽기 모드 키 하나씩(&bootloader 는 누른 쪽 반쪽이 부트로더로 감: 왼쪽 윗줄 끝 = 왼쪽 반쪽, 오른쪽 윗줄 끝 = 오른쪽 반쪽). 리셋 버튼 없이 uf2 드라이브 진입. 범근님 '리셋 버튼 없는데' 260929)
 */
#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define NUM   1
#define EXCEL 2

&num_word {
    // 숫자 키는 기본으로 유지. 사칙연산·소수점·천단위·퍼센트도 유지. 그 밖의 키(Space·Enter·화살표·한글 자모 등)는 즉시 기본층 복귀.
    continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL KP_PLUS KP_MINUS KP_ASTERISK KP_SLASH PRCNT>;
    ignore-modifiers;
};

/ {
    behaviors {
        tt: tap_toggle_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    macros {
        m0: m0_paste_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LC(V) &kp RET>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            // | Tab   | Q      | W    | E     | R   | T  |              | Y   | U     | I    | O    | P    | Bksp  |
            // | LShft | A      | S    | D     | F   | G  |              | H   | J     | K    | L    | /    | Enter |
            // | Del   | Ctrl+A | Z    | X     | C   | V  | TT2 | -      | B   | N     | M    | .    | Up   | RShft |
            // | LCtrl | LGui   | LAlt | Enter | NUM | M0 |              | TG1 | Space | RAlt | Left | Down | Right |
            bindings = <
&kp TAB    &kp Q      &kp W     &kp E    &kp R          &kp T                                     &kp Y     &kp U      &kp I     &kp O     &kp P     &kp BSPC
&kp LSHFT  &kp A      &kp S     &kp D    &kp F          &kp G                                     &kp H     &kp J      &kp K     &kp L     &kp FSLH  &kp RET
&kp DEL    &kp LC(A)  &kp Z     &kp X    &kp C          &kp V   &tt EXCEL EXCEL  &kp KP_MINUS     &kp B     &kp N      &kp M     &kp DOT   &kp UP    &kp RSHFT
&kp LCTRL  &kp LGUI   &kp LALT  &kp RET  &num_word NUM  &m0                                       &tog NUM  &kp SPACE  &kp RALT  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "Num";
            // | Esc   | 1    | 2      | 3     | 4        | 5      |           | 6   | 7     | 8 | 9    | 0    | Bksp  |
            // | LShft | @    | *      | +     | #        | $      |           | -   | =     | [ | ]    | /    | Enter |
            // | TG1   | Up   | Ctrl++ | Alt+1 | Ctrl+D   | Ctrl+1 | -- | --   | `   | ,     | : | '    | Up   | Del   |
            // | LCtrl | Down | --     | Enter | TG1(끄기) | M0    |           | TG1 | Space | . | Left | Down | Right |
            bindings = <
&kp ESC    &kp N1    &kp N2           &kp N3       &kp N4     &kp N5                             &kp N6     &kp N7     &kp N8     &kp N9    &kp N0        &kp BSPC
&kp LSHFT  &kp AT    &kp KP_ASTERISK  &kp KP_PLUS  &kp HASH   &kp DLLR                           &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp KP_SLASH  &kp RET
&tog NUM   &kp UP    &kp LC(KP_PLUS)  &kp LA(N1)   &kp LC(D)  &kp LC(N1)  &none     &none        &kp GRAVE  &kp COMMA  &kp COLON  &kp SQT   &kp UP        &kp DEL
&kp LCTRL  &kp DOWN  &none            &kp RET      &tog NUM   &m0                                &tog NUM   &kp SPACE  &kp DOT    &kp LEFT  &kp DOWN      &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        excel_layer {
            display-name = "Excel";
            // | Esc   | BT1    | BT2   | BT3 | BT지우기 | 왼쪽굽기 |       | USB/BT | -- | -- | -- | -- | 오른쪽굽기 |
            // | LShft | Ctrl+R | 1     | 2  | 3     | --     |           | --  | --  | --  | --      | --     | --    |
            // | TG2   | Up     | 4     | 5  | 6     | Ctrl+A | -- | --   | --  | --  | --  | --      | Up     | --    |
            // | Left  | Down   | Enter | -- | Space | --     |           | --  | --  | --  | Left    | Down   | Right |
            bindings = <
&kp ESC     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &bootloader          &out OUT_TOG  &none         &none         &none       &none         &bootloader
&kp LSHFT   &kp LC(R)  &kp N1   &kp N2  &kp N3     &none                                &none         &none         &none         &none       &none         &none
&tog EXCEL  &kp UP     &kp N4   &kp N5  &kp N6     &kp LC(A)  &none        &none        &none         &none         &none         &none       &kp UP        &none
&kp LEFT    &kp DOWN   &kp RET  &none   &kp SPACE  &none                                &none         &none         &none         &kp LEFT    &kp DOWN      &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
